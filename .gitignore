# Build artifacts
target/
*.exe
*.pdb

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Cached GL nodes (regeneratable)
~/.cache/ccm_gl/

# Per-cwd disk caches written by tests / runs (regeneratable).
# The toolkit writes these to <cwd>/data/*_cache/ — see README.
# We keep the cache directories in the repo (via a tracked .gitkeep in
# each) so the layout is self-documenting, but ignore the generated
# fixtures themselves (.json / .json.zip / byte-split .partXX).
**/data/gl_cache/**
**/data/tau_cache/**
**/data/prolate_eigvals_cache/**
**/data/weil_eigvec_cache/**
# ...except the .gitkeep placeholders that preserve the directories.
!**/data/gl_cache/.gitkeep
!**/data/tau_cache/.gitkeep
!**/data/prolate_eigvals_cache/.gitkeep
!**/data/weil_eigvec_cache/.gitkeep

# Editor swap
*.swp
*~
