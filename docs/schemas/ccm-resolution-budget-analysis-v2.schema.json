{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ccm_resolution_budget_analysis retained observation v2",
  "description": "Retained observation payload; exact requests and ancestry are authenticated by the manifest. Shape validation is not numerical proof. Separate same-kind finite/cohort/preparation APIs retain their own data validators.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "semantics",
    "kind",
    "scope",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "semantics": {
      "const": "ccm_resolution_budget_analysis/value-v1"
    },
    "kind": {
      "const": "ccm_resolution_budget_analysis"
    },
    "scope": {
      "const": "finite_point_inputs; no_source_error_enclosure; no_ground_selection_or_convergence_certificate"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnostic",
        "outcome",
        "reason",
        "lambda_squared",
        "n_modes",
        "source_precision_bits",
        "working_precision_bits",
        "convention",
        "assurance",
        "values",
        "rows"
      ],
      "properties": {
        "diagnostic": {
          "const": "resolution_budget"
        },
        "outcome": {
          "enum": [
            "point_measurement",
            "partial_unresolved",
            "unresolved",
            "missing_input",
            "rank_or_precision_unresolved",
            "conditional_bound_expression",
            "sufficient_bound_unavailable"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "lambda_squared": {
          "type": "string",
          "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?![\\s\\S])"
        },
        "n_modes": {
          "type": "integer",
          "minimum": 0
        },
        "source_precision_bits": {
          "type": "integer",
          "minimum": 0
        },
        "working_precision_bits": {
          "type": "integer",
          "minimum": 0
        },
        "convention": {
          "type": "string"
        },
        "assurance": {
          "enum": [
            "point_diagnostics_only; external_inputs_and_allowances_not_certified; no_RH_or_ground_selection_premise",
            "finite_stored_point_arithmetic_enclosures; conditional root distance bounds; external source errors and target isolation or curvature hypotheses not certified"
          ]
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?![\\s\\S])"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ordinal",
              "label",
              "outcome",
              "values",
              "notes"
            ],
            "properties": {
              "ordinal": {
                "type": "integer",
                "minimum": 1
              },
              "label": {
                "type": "string"
              },
              "outcome": {
                "enum": [
                  "point_measurement",
                  "missing_input",
                  "budget_limited",
                  "carrier_or_unresolved",
                  "unresolved_denominator",
                  "cancellation_limited",
                  "unresolved_derivative",
                  "channels_resolved_budget_unassessed",
                  "conditional_budget_met",
                  "conditional_budget_not_met",
                  "conditional_budget_unresolved"
                ]
              },
              "values": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?![\\s\\S])"
                }
              },
              "notes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "outcome": {
                      "enum": [
                        "point_measurement",
                        "certified_finite_enclosure"
                      ]
                    }
                  }
                },
                "then": {
                  "properties": {
                    "values": {
                      "required": [
                        "t",
                        "transform",
                        "derivative"
                      ]
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "enum": [
                  "point_measurement",
                  "certified_finite_enclosure",
                  "conditional_bound_expression"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "values": {
                "required": [
                  "conditional_contiguous_prefix",
                  "relative_tolerance",
                  "finite_curvature_expression"
                ]
              }
            }
          }
        }
      ]
    },
    "expected_rows": {
      "type": "integer",
      "minimum": 0
    }
  },
  "allOf": [
    {
      "allOf": [
        {
          "properties": {
            "data": {
              "properties": {
                "assurance": {
                  "const": "finite_stored_point_arithmetic_enclosures; conditional root distance bounds; external source errors and target isolation or curvature hypotheses not certified"
                }
              }
            }
          }
        }
      ]
    },
    {
      "allOf": [
        {
          "properties": {
            "data": {
              "properties": {
                "rows": {
                  "items": {
                    "allOf": [
                      {
                        "if": {
                          "anyOf": [
                            {
                              "properties": {
                                "values": {
                                  "required": [
                                    "transform"
                                  ]
                                }
                              }
                            },
                            {
                              "properties": {
                                "outcome": {
                                  "enum": [
                                    "unresolved_derivative",
                                    "channels_resolved_budget_unassessed",
                                    "conditional_budget_met",
                                    "conditional_budget_not_met",
                                    "conditional_budget_unresolved"
                                  ]
                                }
                              }
                            }
                          ]
                        },
                        "then": {
                          "properties": {
                            "values": {
                              "required": [
                                "t",
                                "transform",
                                "derivative",
                                "absolute_value_terms",
                                "absolute_derivative_terms",
                                "t_lower",
                                "t_upper",
                                "transform_lower",
                                "transform_upper",
                                "derivative_lower",
                                "derivative_upper",
                                "absolute_value_terms_lower",
                                "absolute_value_terms_upper",
                                "absolute_derivative_terms_lower",
                                "absolute_derivative_terms_upper",
                                "arithmetic_precision_bits"
                              ]
                            }
                          }
                        }
                      },
                      {
                        "if": {
                          "properties": {
                            "outcome": {
                              "const": "conditional_budget_met"
                            }
                          }
                        },
                        "then": {
                          "properties": {
                            "values": {
                              "required": [
                                "conditional_root_distance_allowance",
                                "conditional_slope_margin",
                                "declared_radius",
                                "conditional_budget_target",
                                "declared_source_value_error",
                                "declared_source_derivative_error",
                                "conditional_value_numerator",
                                "conditional_root_distance_allowance_lower",
                                "conditional_root_distance_allowance_upper",
                                "conditional_slope_margin_lower",
                                "conditional_slope_margin_upper",
                                "declared_radius_lower",
                                "declared_radius_upper",
                                "conditional_budget_target_lower",
                                "conditional_budget_target_upper",
                                "declared_source_value_error_lower",
                                "declared_source_value_error_upper",
                                "declared_source_derivative_error_lower",
                                "declared_source_derivative_error_upper",
                                "conditional_value_numerator_lower",
                                "conditional_value_numerator_upper"
                              ]
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "outcome": {
                        "enum": [
                          "point_measurement",
                          "partial_unresolved"
                        ]
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "values": {
                        "required": [
                          "finite_curvature_expression",
                          "relative_tolerance",
                          "finite_curvature_expression_lower",
                          "finite_curvature_expression_upper",
                          "relative_tolerance_lower",
                          "relative_tolerance_upper",
                          "conditional_contiguous_prefix"
                        ]
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
