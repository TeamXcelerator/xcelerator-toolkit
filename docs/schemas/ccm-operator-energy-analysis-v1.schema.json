{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ccm_operator_energy_analysis v1",
  "description": "Source-bound observations; shape validation does not establish numerical correctness, ground selection, or convergence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "semantics",
    "kind",
    "scope",
    "source_dependencies",
    "request",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "semantics": {
      "enum": [
        "ccm-retained-research-observations-v1",
        "ccm-retained-research-observations-v2",
        "ccm-retained-research-observations-v3",
        "ccm-retained-research-observations-v4",
        "ccm-retained-research-observations-v5",
        "ccm-retained-research-observations-v6",
        "ccm-retained-research-observations-v7",
        "ccm-retained-research-observations-v8",
        "ccm-retained-research-observations-v9",
        "ccm-retained-research-observations-v10",
        "ccm-retained-research-observations-v11",
        "ccm-retained-research-observations-v12",
        "ccm-retained-research-observations-v13",
        "ccm-retained-research-observations-v14",
        "ccm-retained-research-observations-v15",
        "ccm-retained-research-observations-v16",
        "ccm-retained-research-observations-v17",
        "ccm-retained-research-observations-v18",
        "ccm-retained-research-observations-v19",
        "ccm-retained-research-observations-v20",
        "ccm-retained-research-observations-v21",
        "ccm-retained-research-observations-v22"
      ]
    },
    "kind": {
      "const": "ccm_operator_energy_analysis"
    },
    "scope": {
      "const": "finite_point_inputs; no_source_error_enclosure; no_ground_selection_or_convergence_certificate"
    },
    "source_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "content_digest",
          "required_quality"
        ],
        "properties": {
          "key": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "logical_key",
              "parameters_digest"
            ],
            "properties": {
              "kind": {
                "type": "string"
              },
              "logical_key": {
                "type": "string"
              },
              "parameters_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
              }
            }
          },
          "content_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
          },
          "required_quality": {
            "enum": [
              "validated",
              "cross_checked",
              "certified",
              "published",
              "quarantined",
              "staged",
              "deprecated"
            ]
          }
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "precision_bits",
        "formula"
      ],
      "properties": {
        "precision_bits": {
          "type": "integer",
          "minimum": 0
        },
        "formula": {
          "type": "string"
        },
        "residual_semantics": {
          "const": "raw_matrix_explicit_zero_eigenvalue_normalization_v2"
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lambda_squared",
        "n_modes",
        "precision_bits",
        "source_eigenvalue",
        "coefficient_norm_squared",
        "rayleigh_quotient",
        "eigenvalue_defect",
        "relative_residual",
        "sum_absolute_energy_terms",
        "cancellation_digits",
        "component_decomposition",
        "ground_selection"
      ],
      "properties": {
        "lambda_squared": {
          "type": "string",
          "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?![\\s\\S])"
        },
        "n_modes": {
          "type": "integer",
          "minimum": 0
        },
        "precision_bits": {
          "type": "integer",
          "minimum": 0
        },
        "source_eigenvalue": {
          "type": "string",
          "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?![\\s\\S])"
        },
        "coefficient_norm_squared": {
          "type": "string",
          "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?![\\s\\S])"
        },
        "rayleigh_quotient": {
          "type": "string",
          "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?![\\s\\S])"
        },
        "eigenvalue_defect": {
          "type": "string",
          "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?![\\s\\S])"
        },
        "relative_residual": {
          "type": "string",
          "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?![\\s\\S])"
        },
        "residual_normalization": {
          "enum": [
            "absolute_residual_per_coefficient_l2_norm",
            "relative_to_abs_eigenvalue_and_coefficient_l2_norm"
          ]
        },
        "sum_absolute_energy_terms": {
          "type": "string",
          "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?![\\s\\S])"
        },
        "cancellation_digits": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "component_decomposition": {
          "type": "string"
        },
        "ground_selection": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "request": {
            "required": [
              "residual_semantics"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "required": [
              "residual_normalization"
            ]
          }
        }
      }
    }
  ]
}
