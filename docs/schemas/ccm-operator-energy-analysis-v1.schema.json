{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ccm_operator_energy_analysis v1",
  "description": "Source-bound observations; shape validation does not establish numerical correctness, ground selection, or convergence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "semantics",
    "kind",
    "scope",
    "source_dependencies",
    "request",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "semantics": {
      "const": "ccm-retained-research-observations-v1"
    },
    "kind": {
      "const": "ccm_operator_energy_analysis"
    },
    "scope": {
      "const": "finite_point_inputs; no_source_error_enclosure; no_ground_selection_or_convergence_certificate"
    },
    "source_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "content_digest",
          "required_quality"
        ],
        "properties": {
          "key": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "logical_key",
              "parameters_digest"
            ],
            "properties": {
              "kind": {
                "type": "string"
              },
              "logical_key": {
                "type": "string"
              },
              "parameters_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "content_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "required_quality": {
            "enum": [
              "validated",
              "cross_checked",
              "certified",
              "published",
              "quarantined",
              "staged",
              "deprecated"
            ]
          }
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "precision_bits",
        "formula"
      ],
      "properties": {
        "precision_bits": {
          "type": "integer",
          "minimum": 0
        },
        "formula": {
          "type": "string"
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lambda_squared",
        "n_modes",
        "precision_bits",
        "source_eigenvalue",
        "coefficient_norm_squared",
        "rayleigh_quotient",
        "eigenvalue_defect",
        "relative_residual",
        "sum_absolute_energy_terms",
        "cancellation_digits",
        "component_decomposition",
        "ground_selection"
      ],
      "properties": {
        "lambda_squared": {
          "type": "string",
          "pattern": "^-?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
        },
        "n_modes": {
          "type": "integer",
          "minimum": 0
        },
        "precision_bits": {
          "type": "integer",
          "minimum": 0
        },
        "source_eigenvalue": {
          "type": "string",
          "pattern": "^-?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
        },
        "coefficient_norm_squared": {
          "type": "string",
          "pattern": "^-?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
        },
        "rayleigh_quotient": {
          "type": "string",
          "pattern": "^-?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
        },
        "eigenvalue_defect": {
          "type": "string",
          "pattern": "^-?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
        },
        "relative_residual": {
          "type": "string",
          "pattern": "^-?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
        },
        "sum_absolute_energy_terms": {
          "type": "string",
          "pattern": "^-?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
        },
        "cancellation_digits": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "component_decomposition": {
          "type": "string"
        },
        "ground_selection": {
          "type": "string"
        }
      }
    }
  }
}
