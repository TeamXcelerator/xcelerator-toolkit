{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ccm_weighted_reference_projection retained observation v2",
  "description": "Retained observation payload; exact requests and ancestry are authenticated by the manifest. Shape validation is not numerical proof. Separate same-kind finite/cohort/preparation APIs retain their own data validators.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "semantics",
    "kind",
    "scope",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "semantics": {
      "const": "ccm_weighted_reference_projection/value-v1"
    },
    "kind": {
      "const": "ccm_weighted_reference_projection"
    },
    "scope": {
      "const": "finite_point_inputs; no_source_error_enclosure; no_ground_selection_or_convergence_certificate"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnostic",
        "outcome",
        "reason",
        "lambda_squared",
        "n_modes",
        "source_precision_bits",
        "working_precision_bits",
        "convention",
        "assurance",
        "values",
        "rows"
      ],
      "properties": {
        "diagnostic": {
          "const": "weighted_reference_projection"
        },
        "outcome": {
          "enum": [
            "point_measurement",
            "partial_unresolved",
            "unresolved",
            "missing_input",
            "rank_or_precision_unresolved",
            "conditional_bound_expression",
            "sufficient_bound_unavailable"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "lambda_squared": {
          "type": "string",
          "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?![\\s\\S])"
        },
        "n_modes": {
          "type": "integer",
          "minimum": 0
        },
        "source_precision_bits": {
          "type": "integer",
          "minimum": 0
        },
        "working_precision_bits": {
          "type": "integer",
          "minimum": 0
        },
        "convention": {
          "type": "string"
        },
        "assurance": {
          "enum": [
            "point_diagnostics_only; external_inputs_and_allowances_not_certified; no_RH_or_ground_selection_premise",
            "finite_grid_arithmetic_enclosures; exact stored source/reference points; excludes source-construction and quadrature errors; no continuum or limit claim"
          ]
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?![\\s\\S])"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ordinal",
              "label",
              "outcome",
              "values",
              "notes"
            ],
            "properties": {
              "ordinal": {
                "type": "integer",
                "minimum": 1
              },
              "label": {
                "type": "string"
              },
              "outcome": {
                "enum": [
                  "point_measurement",
                  "missing_input",
                  "budget_limited",
                  "carrier_or_unresolved",
                  "unresolved_denominator",
                  "cancellation_limited",
                  "unresolved_derivative",
                  "channels_resolved_budget_unassessed",
                  "conditional_budget_met",
                  "conditional_budget_not_met",
                  "conditional_budget_unresolved"
                ]
              },
              "values": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?![\\s\\S])"
                }
              },
              "notes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "enum": [
                  "point_measurement",
                  "certified_finite_enclosure",
                  "conditional_bound_expression"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "values": {
                "required": [
                  "source_raw_center",
                  "weighted_l1",
                  "weighted_l2_squared",
                  "signed_integral"
                ]
              }
            }
          }
        }
      ]
    },
    "expected_rows": {
      "type": "integer",
      "minimum": 0
    }
  },
  "allOf": [
    {
      "allOf": [
        {
          "properties": {
            "data": {
              "properties": {
                "assurance": {
                  "const": "finite_grid_arithmetic_enclosures; exact stored source/reference points; excludes source-construction and quadrature errors; no continuum or limit claim"
                }
              }
            }
          }
        }
      ]
    },
    {
      "if": {
        "properties": {
          "data": {
            "properties": {
              "outcome": {
                "enum": [
                  "point_measurement",
                  "rank_or_precision_unresolved"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "properties": {
              "values": {
                "required": [
                  "source_raw_center",
                  "weighted_l1",
                  "weighted_l2_squared",
                  "signed_integral",
                  "source_raw_center_lower",
                  "source_raw_center_upper",
                  "weighted_l1_lower",
                  "weighted_l1_upper",
                  "weighted_l2_squared_lower",
                  "weighted_l2_squared_upper",
                  "signed_integral_lower",
                  "signed_integral_upper",
                  "arithmetic_precision_bits"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
