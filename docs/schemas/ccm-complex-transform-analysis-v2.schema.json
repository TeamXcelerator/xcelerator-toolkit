{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ccm_complex_transform_analysis retained observation v2",
  "description": "Retained observation payload; exact requests and ancestry are authenticated by the manifest. Shape validation is not numerical proof. Separate same-kind finite/cohort/preparation APIs retain their own data validators.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "semantics",
    "kind",
    "scope",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "semantics": {
      "const": "ccm_complex_transform_analysis/value-v1"
    },
    "kind": {
      "const": "ccm_complex_transform_analysis"
    },
    "scope": {
      "const": "finite_point_inputs; no_source_error_enclosure; no_ground_selection_or_convergence_certificate"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnostic",
        "outcome",
        "reason",
        "lambda_squared",
        "n_modes",
        "source_precision_bits",
        "working_precision_bits",
        "convention",
        "assurance",
        "values",
        "rows"
      ],
      "properties": {
        "diagnostic": {
          "const": "complex_transform"
        },
        "outcome": {
          "enum": [
            "point_measurement",
            "partial_unresolved",
            "unresolved",
            "missing_input",
            "rank_or_precision_unresolved",
            "conditional_bound_expression",
            "sufficient_bound_unavailable"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "lambda_squared": {
          "type": "string",
          "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?![\\s\\S])"
        },
        "n_modes": {
          "type": "integer",
          "minimum": 0
        },
        "source_precision_bits": {
          "type": "integer",
          "minimum": 0
        },
        "working_precision_bits": {
          "type": "integer",
          "minimum": 0
        },
        "convention": {
          "type": "string"
        },
        "assurance": {
          "enum": [
            "point_diagnostics_only; external_inputs_and_allowances_not_certified; no_RH_or_ground_selection_premise",
            "finite_stored_point_arithmetic_enclosures; exact cutoff and retained ordinates; samples do not certify contour counts, roots or source errors"
          ]
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?![\\s\\S])"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ordinal",
              "label",
              "outcome",
              "values",
              "notes"
            ],
            "properties": {
              "ordinal": {
                "type": "integer",
                "minimum": 1
              },
              "label": {
                "type": "string"
              },
              "outcome": {
                "enum": [
                  "point_measurement",
                  "missing_input",
                  "budget_limited",
                  "carrier_or_unresolved",
                  "unresolved_denominator",
                  "cancellation_limited",
                  "unresolved_derivative",
                  "channels_resolved_budget_unassessed",
                  "conditional_budget_met",
                  "conditional_budget_not_met",
                  "conditional_budget_unresolved"
                ]
              },
              "values": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?![\\s\\S])"
                }
              },
              "notes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "outcome": {
                      "enum": [
                        "point_measurement",
                        "certified_finite_enclosure"
                      ]
                    }
                  }
                },
                "then": {
                  "properties": {
                    "values": {
                      "required": [
                        "z_re",
                        "z_im",
                        "value_re",
                        "value_im",
                        "derivative_re",
                        "derivative_im"
                      ]
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "enum": [
                  "point_measurement",
                  "certified_finite_enclosure",
                  "conditional_bound_expression"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "values": {
                "required": [
                  "normalization_anchor"
                ]
              }
            }
          }
        }
      ]
    },
    "expected_rows": {
      "type": "integer",
      "minimum": 0
    }
  },
  "allOf": [
    {
      "allOf": [
        {
          "properties": {
            "data": {
              "properties": {
                "assurance": {
                  "const": "finite_stored_point_arithmetic_enclosures; exact cutoff and retained ordinates; samples do not certify contour counts, roots or source errors"
                }
              }
            }
          }
        }
      ]
    },
    {
      "allOf": [
        {
          "properties": {
            "data": {
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "outcome": {
                        "enum": [
                          "point_measurement",
                          "partial_unresolved"
                        ]
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "values": {
                        "required": [
                          "normalization_anchor",
                          "normalization_anchor_lower",
                          "normalization_anchor_upper",
                          "arithmetic_precision_bits"
                        ]
                      },
                      "rows": {
                        "items": {
                          "allOf": [
                            {
                              "if": {
                                "anyOf": [
                                  {
                                    "properties": {
                                      "values": {
                                        "required": [
                                          "value_re"
                                        ]
                                      }
                                    }
                                  },
                                  {
                                    "properties": {
                                      "outcome": {
                                        "enum": [
                                          "point_measurement",
                                          "unresolved_denominator"
                                        ]
                                      }
                                    }
                                  }
                                ]
                              },
                              "then": {
                                "properties": {
                                  "values": {
                                    "required": [
                                      "input_ordinal",
                                      "z_re",
                                      "z_im",
                                      "value_re",
                                      "value_im",
                                      "derivative_re",
                                      "derivative_im",
                                      "sum_absolute_terms",
                                      "normalization_denominator_resolved",
                                      "log_derivative_denominator_resolved",
                                      "input_ordinal_lower",
                                      "input_ordinal_upper",
                                      "z_re_lower",
                                      "z_re_upper",
                                      "z_im_lower",
                                      "z_im_upper",
                                      "value_re_lower",
                                      "value_re_upper",
                                      "value_im_lower",
                                      "value_im_upper",
                                      "derivative_re_lower",
                                      "derivative_re_upper",
                                      "derivative_im_lower",
                                      "derivative_im_upper",
                                      "sum_absolute_terms_lower",
                                      "sum_absolute_terms_upper",
                                      "normalization_denominator_resolved_lower",
                                      "normalization_denominator_resolved_upper",
                                      "log_derivative_denominator_resolved_lower",
                                      "log_derivative_denominator_resolved_upper",
                                      "arithmetic_precision_bits"
                                    ]
                                  }
                                }
                              }
                            },
                            {
                              "if": {
                                "properties": {
                                  "values": {
                                    "required": [
                                      "normalized_re"
                                    ]
                                  }
                                }
                              },
                              "then": {
                                "properties": {
                                  "values": {
                                    "required": [
                                      "normalized_re",
                                      "normalized_im",
                                      "normalized_re_lower",
                                      "normalized_re_upper",
                                      "normalized_im_lower",
                                      "normalized_im_upper",
                                      "arithmetic_precision_bits"
                                    ]
                                  }
                                }
                              }
                            },
                            {
                              "if": {
                                "properties": {
                                  "values": {
                                    "required": [
                                      "log_derivative_re"
                                    ]
                                  }
                                }
                              },
                              "then": {
                                "properties": {
                                  "values": {
                                    "required": [
                                      "log_derivative_re",
                                      "log_derivative_im",
                                      "log_derivative_re_lower",
                                      "log_derivative_re_upper",
                                      "log_derivative_im_lower",
                                      "log_derivative_im_upper",
                                      "arithmetic_precision_bits"
                                    ]
                                  }
                                }
                              }
                            },
                            {
                              "if": {
                                "properties": {
                                  "outcome": {
                                    "const": "point_measurement"
                                  }
                                }
                              },
                              "then": {
                                "properties": {
                                  "values": {
                                    "required": [
                                      "normalized_re",
                                      "normalized_im",
                                      "log_derivative_re",
                                      "log_derivative_im",
                                      "normalized_re_lower",
                                      "normalized_re_upper",
                                      "normalized_im_lower",
                                      "normalized_im_upper",
                                      "log_derivative_re_lower",
                                      "log_derivative_re_upper",
                                      "log_derivative_im_lower",
                                      "log_derivative_im_upper",
                                      "arithmetic_precision_bits"
                                    ]
                                  }
                                }
                              }
                            }
                          ]
                        }
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
