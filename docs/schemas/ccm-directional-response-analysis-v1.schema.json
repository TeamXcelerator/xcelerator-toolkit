        "properties": {
          "key": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "logical_key",
              "parameters_digest"
            ],
            "properties": {
              "kind": {
                "type": "string"
              },
              "logical_key": {
                "type": "string"
              },
              "parameters_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
              }
            }
          },
          "content_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
          },
          "required_quality": {
            "enum": [
              "validated",
              "cross_checked",
              "certified",
              "published",
              "quarantined",
              "staged",
              "deprecated"
            ]
          }
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantics",
        "diagnostic",
        "expected_rows",
        "options",
        "external_input_digest",
        "state_selection_policy",
        "state_manifest_tags"
      ],
      "properties": {
        "semantics": {
          "enum": [
            "extended-retained-diagnostics-v2",
            "extended-retained-diagnostics-v3",
            "extended-retained-diagnostics-v4"
          ]
        },
        "diagnostic": {
          "const": "directional_response"
        },
        "expected_rows": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "working_precision_bits",
            "maximum_rows",
            "maximum_directional_rows",
            "maximum_estimated_output_bytes",
