              "label": {
                "type": "string"
              },
              "outcome": {
                "enum": [
                  "point_measurement",
                  "missing_input",
                  "budget_limited",
                  "carrier_or_unresolved",
                  "unresolved_denominator",
                  "cancellation_limited",
                  "unresolved_derivative",
                  "channels_resolved_budget_unassessed",
                  "conditional_budget_met",
                  "conditional_budget_not_met",
                  "conditional_budget_unresolved"
                ]
              },
              "values": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?![\\s\\S])"
                }
              },
              "notes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "outcome": {
                      "enum": [
                        "point_measurement",
                        "certified_finite_enclosure"
                      ]
                    }
                  }
                },
                "then": {
                  "properties": {
                    "values": {
                      "required": [
                        "t",
                        "tau",
                        "direction_norm_squared",
                        "directional_energy"
                      ]
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "enum": [
                  "point_measurement",
                  "certified_finite_enclosure",
                  "conditional_bound_expression"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "values": {
                "required": []
              }
            }
          }
        }
      ]
