{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ccm_indexed_transform_analysis v1",
  "description": "Source-bound observations; shape validation does not establish numerical correctness, ground selection, or convergence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "semantics",
    "kind",
    "scope",
    "source_dependencies",
    "request",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "semantics": {
      "enum": [
        "ccm-retained-research-observations-v1",
        "ccm-retained-research-observations-v2",
        "ccm-retained-research-observations-v3",
        "ccm-retained-research-observations-v4",
        "ccm-retained-research-observations-v5",
        "ccm-retained-research-observations-v6",
        "ccm-retained-research-observations-v7",
        "ccm-retained-research-observations-v8",
        "ccm-retained-research-observations-v9",
        "ccm-retained-research-observations-v10",
        "ccm-retained-research-observations-v11",
        "ccm-retained-research-observations-v12",
        "ccm-retained-research-observations-v13",
        "ccm-retained-research-observations-v14",
        "ccm-retained-research-observations-v15",
        "ccm-retained-research-observations-v16",
        "ccm-retained-research-observations-v17",
        "ccm-retained-research-observations-v18",
        "ccm-retained-research-observations-v19",
        "ccm-retained-research-observations-v20",
        "ccm-retained-research-observations-v21",
        "ccm-retained-research-observations-v22"
      ]
    },
    "kind": {
      "const": "ccm_indexed_transform_analysis"
    },
    "scope": {
      "const": "finite_point_inputs; no_source_error_enclosure; no_ground_selection_or_convergence_certificate"
    },
    "source_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "content_digest",
          "required_quality"
        ],
        "properties": {
          "key": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "logical_key",
              "parameters_digest"
            ],
            "properties": {
              "kind": {
                "type": "string"
              },
              "logical_key": {
                "type": "string"
              },
              "parameters_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
              }
            }
          },
          "content_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
          },
          "required_quality": {
            "enum": [
              "validated",
              "cross_checked",
              "certified",
              "published",
              "quarantined",
              "staged",
              "deprecated"
            ]
          }
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "options",
        "dataset",
        "formula"
      ],
      "properties": {
        "options": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "working_precision_bits",
            "maximum_rows",
            "maximum_estimated_output_bytes"
          ],
          "properties": {
            "working_precision_bits": {
              "type": "integer",
              "minimum": 0
            },
            "maximum_rows": {
              "type": "integer",
              "minimum": 0
            },
            "maximum_estimated_output_bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "dataset": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "role",
            "attribution",
            "coordinate",
            "precision_bits",
            "points"
          ],
          "properties": {
            "schema_version": {
              "const": 1
            },
            "role": {
              "enum": [
                "known_zeta_ordinates",
                "evaluation_points",
                "retained_ccm_roots"
              ]
            },
            "attribution": {
              "type": "string"
            },
            "coordinate": {
              "const": "mellin_t"
            },
            "precision_bits": {
              "type": "integer",
              "minimum": 0
            },
            "points": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "ordinal",
                  "value",
                  "source_status"
                ],
                "properties": {
                  "ordinal": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "value": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?![\\s\\S])"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "source_status": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "formula": {
          "type": "string"
        },
        "transform_arithmetic": {
          "enum": [
            "exact_cutoff_stored_points_directed_sinc_v1",
            "exact_cutoff_stored_points_directed_sinc_root_convention_v2"
          ]
        },
        "maximum_transform_guard_bits": {
          "const": 4096
        },
        "curvature_output": {
          "const": "outward_upper_endpoint_v1"
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordinate",
        "normalization",
        "input_role",
        "source_precision_bits",
        "working_precision_bits",
        "finite_support",
        "physical_tail",
        "second_derivative_cauchy_schwarz_expression",
        "rows"
      ],
      "properties": {
        "coordinate": {
          "type": "string"
        },
        "normalization": {
          "type": "string"
        },
        "input_role": {
          "type": "string"
        },
        "source_precision_bits": {
          "type": "integer",
          "minimum": 0
        },
        "working_precision_bits": {
          "type": "integer",
          "minimum": 0
        },
        "finite_support": {
          "type": "string"
        },
        "physical_tail": {
          "type": "string"
        },
        "second_derivative_cauchy_schwarz_expression": {
          "type": "string",
          "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?![\\s\\S])"
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ordinal",
              "source_status",
              "t",
              "outcome",
              "value",
              "derivative",
              "sum_absolute_terms",
              "sum_absolute_derivative_terms",
              "cancellation_digits",
              "newton_correction",
              "newton_remainder"
            ],
            "properties": {
              "ordinal": {
                "type": "integer",
                "minimum": 0
              },
              "source_status": {
                "type": "string"
              },
              "t": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?![\\s\\S])"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "outcome": {
                "enum": [
                  "missing_input",
                  "point_measurement",
                  "unresolved_derivative",
                  "cancellation_limited"
                ]
              },
              "value": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?![\\s\\S])"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "derivative": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?![\\s\\S])"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sum_absolute_terms": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?![\\s\\S])"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sum_absolute_derivative_terms": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?![\\s\\S])"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "cancellation_digits": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?![\\s\\S])"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "newton_correction": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?![\\s\\S])"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "newton_remainder": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "semantics": {
            "enum": [
              "ccm-retained-research-observations-v13",
              "ccm-retained-research-observations-v14",
              "ccm-retained-research-observations-v15",
              "ccm-retained-research-observations-v16",
              "ccm-retained-research-observations-v17",
              "ccm-retained-research-observations-v18",
              "ccm-retained-research-observations-v19",
              "ccm-retained-research-observations-v20",
              "ccm-retained-research-observations-v21",
              "ccm-retained-research-observations-v22"
            ]
          }
        },
        "required": [
          "semantics"
        ]
      },
      "then": {
        "properties": {
          "request": {
            "required": [
              "transform_arithmetic",
              "maximum_transform_guard_bits",
              "curvature_output"
            ]
          }
        }
      }
    }
  ]
}
