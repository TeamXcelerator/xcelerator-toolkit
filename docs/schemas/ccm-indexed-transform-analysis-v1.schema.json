{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ccm_indexed_transform_analysis v1",
  "description": "Source-bound observations; shape validation does not establish numerical correctness, ground selection, or convergence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "semantics",
    "kind",
    "scope",
    "source_dependencies",
    "request",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "semantics": {
      "const": "ccm-retained-research-observations-v1"
    },
    "kind": {
      "const": "ccm_indexed_transform_analysis"
    },
    "scope": {
      "const": "finite_point_inputs; no_source_error_enclosure; no_ground_selection_or_convergence_certificate"
    },
    "source_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "content_digest",
          "required_quality"
        ],
        "properties": {
          "key": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "logical_key",
              "parameters_digest"
            ],
            "properties": {
              "kind": {
                "type": "string"
              },
              "logical_key": {
                "type": "string"
              },
              "parameters_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "content_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "required_quality": {
            "enum": [
              "validated",
              "cross_checked",
              "certified",
              "published",
              "quarantined",
              "staged",
              "deprecated"
            ]
          }
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "options",
        "dataset",
        "formula"
      ],
      "properties": {
        "options": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "working_precision_bits",
            "maximum_rows",
            "maximum_estimated_output_bytes"
          ],
          "properties": {
            "working_precision_bits": {
              "type": "integer",
              "minimum": 0
            },
            "maximum_rows": {
              "type": "integer",
              "minimum": 0
            },
            "maximum_estimated_output_bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "dataset": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "role",
            "attribution",
            "coordinate",
            "precision_bits",
            "points"
          ],
          "properties": {
            "schema_version": {
              "const": 1
            },
            "role": {
              "enum": [
                "known_zeta_ordinates",
                "evaluation_points",
                "retained_ccm_roots"
              ]
            },
            "attribution": {
              "type": "string"
            },
            "coordinate": {
              "const": "mellin_t"
            },
            "precision_bits": {
              "type": "integer",
              "minimum": 0
            },
            "points": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "ordinal",
                  "value",
                  "source_status"
                ],
                "properties": {
                  "ordinal": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "value": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^-?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "source_status": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "formula": {
          "type": "string"
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordinate",
        "normalization",
        "input_role",
        "source_precision_bits",
        "working_precision_bits",
        "finite_support",
        "physical_tail",
        "second_derivative_cauchy_schwarz_expression",
        "rows"
      ],
      "properties": {
        "coordinate": {
          "type": "string"
        },
        "normalization": {
          "type": "string"
        },
        "input_role": {
          "type": "string"
        },
        "source_precision_bits": {
          "type": "integer",
          "minimum": 0
        },
        "working_precision_bits": {
          "type": "integer",
          "minimum": 0
        },
        "finite_support": {
          "type": "string"
        },
        "physical_tail": {
          "type": "string"
        },
        "second_derivative_cauchy_schwarz_expression": {
          "type": "string",
          "pattern": "^-?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ordinal",
              "source_status",
              "t",
              "outcome",
              "value",
              "derivative",
              "sum_absolute_terms",
              "sum_absolute_derivative_terms",
              "cancellation_digits",
              "newton_correction",
              "newton_remainder"
            ],
            "properties": {
              "ordinal": {
                "type": "integer",
                "minimum": 0
              },
              "source_status": {
                "type": "string"
              },
              "t": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^-?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "outcome": {
                "enum": [
                  "missing_input",
                  "point_measurement",
                  "unresolved_derivative",
                  "cancellation_limited"
                ]
              },
              "value": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^-?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "derivative": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^-?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sum_absolute_terms": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^-?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sum_absolute_derivative_terms": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^-?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "cancellation_digits": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^-?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "newton_correction": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^-?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "newton_remainder": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
