{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ccm_stabilization_analysis retained observation v2",
  "description": "Retained observation payload; exact requests and ancestry are authenticated by the manifest. Shape validation is not numerical proof. Separate same-kind finite/cohort/preparation APIs retain their own data validators.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "semantics",
    "kind",
    "scope",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "semantics": {
      "const": "ccm_stabilization_analysis/value-v1"
    },
    "kind": {
      "const": "ccm_stabilization_analysis"
    },
    "scope": {
      "const": "finite_point_inputs; no_source_error_enclosure; no_ground_selection_or_convergence_certificate"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lambda_squared",
        "observable",
        "qualification",
        "outcome",
        "rows"
      ],
      "properties": {
        "lambda_squared": {
          "type": "string",
          "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?![\\s\\S])"
        },
        "observable": {
          "const": "serialized_retained_Weil_eigenvalue"
        },
        "qualification": {
          "type": "string"
        },
        "outcome": {
          "enum": [
            "finite_rule_met",
            "finite_rule_not_met"
          ]
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "n_modes",
              "value",
              "relative_change",
              "status"
            ],
            "properties": {
              "source": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
              },
              "n_modes": {
                "type": "integer",
                "minimum": 0
              },
              "value": {
                "type": "string",
                "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?![\\s\\S])"
              },
              "relative_change": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?![\\s\\S])"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "status": {
                "enum": [
                  "initial",
                  "zero_denominator",
                  "within_rule",
                  "outside_rule"
                ]
              }
            }
          }
        }
      }
    },
    "expected_rows": {
      "type": "integer",
      "minimum": 0
    }
  }
}
