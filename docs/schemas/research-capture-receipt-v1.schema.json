{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research capture receipt v1",
  "description": "Private-only full research record. Shape validation is not numerical validation: the toolkit reader must verify plan coverage, exact dependency bindings and payload/score replay.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "semantics",
    "resolved_plan",
    "requested_diagnostics",
    "receipt",
    "measurements",
    "source_dependencies"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "semantics": {
      "const": "research-capture-record-v1"
    },
    "resolved_plan": {},
    "requested_diagnostics": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_digest",
        "outcomes"
      ],
      "properties": {
        "plan_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "outcomes": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "evidence"
                ],
                "properties": {
                  "status": {
                    "const": "completed"
                  },
                  "evidence": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "kind",
                        "identifier",
                        "digest",
                        "description"
                      ],
                      "properties": {
                        "kind": {
                          "type": "string",
                          "minLength": 1
                        },
                        "identifier": {
                          "type": "string",
                          "minLength": 1
                        },
                        "digest": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        },
                        "description": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "reason"
                ],
                "properties": {
                  "status": {
                    "const": "missing"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "reason"
                ],
                "properties": {
                  "status": {
                    "const": "blocked"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "reason"
                ],
                "properties": {
                  "status": {
                    "const": "failed"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          }
        }
      }
    },
    "measurements": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value",
          "source_dependencies"
        ],
        "properties": {
          "value": {},
          "source_dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "content_digest",
                "required_quality"
              ],
              "properties": {
                "key": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "logical_key",
                    "parameters_digest"
                  ],
                  "properties": {
                    "kind": {
                      "type": "string",
                      "minLength": 1
                    },
                    "logical_key": {
                      "type": "string",
                      "minLength": 1
                    },
                    "parameters_digest": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  }
                },
                "content_digest": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "required_quality": {
                  "const": "validated"
                }
              }
            }
          }
        }
      }
    },
    "source_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "content_digest",
          "required_quality"
        ],
        "properties": {
          "key": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "logical_key",
              "parameters_digest"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "logical_key": {
                "type": "string",
                "minLength": 1
              },
              "parameters_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "content_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "required_quality": {
            "const": "validated"
          }
        }
      }
    }
  }
}
