{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ccm_reference_projection_analysis retained observation v2",
  "description": "Retained observation payload; exact requests and ancestry are authenticated by the manifest. Shape validation is not numerical proof. Separate same-kind finite/cohort/preparation APIs retain their own data validators.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "semantics",
    "kind",
    "scope",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "semantics": {
      "const": "ccm_reference_projection_analysis/value-v1"
    },
    "kind": {
      "const": "ccm_reference_projection_analysis"
    },
    "scope": {
      "const": "finite_point_inputs; no_source_error_enclosure; no_ground_selection_or_convergence_certificate"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "metric",
        "normalization",
        "source_center",
        "reference_center",
        "signed_unit_overlap",
        "difference_norm_squared",
        "gram",
        "rhs",
        "coefficients",
        "fit_residual_norm_squared",
        "minimum_pivot",
        "fixed_second_component",
        "b_effective",
        "b2",
        "uncertainty"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "normalization_unresolved",
            "rank_or_precision_unresolved",
            "point_measurement"
          ]
        },
        "metric": {
          "type": "string"
        },
        "normalization": {
          "enum": [
            "unit_l2_dx",
            "center_one"
          ]
        },
        "source_center": {
          "type": "string",
          "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?![\\s\\S])"
        },
        "reference_center": {
          "type": "string",
          "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?![\\s\\S])"
        },
        "signed_unit_overlap": {
          "type": "string",
          "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?![\\s\\S])"
        },
        "difference_norm_squared": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "gram": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?![\\s\\S])"
          }
        },
        "rhs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?![\\s\\S])"
          }
        },
        "coefficients": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?![\\s\\S])"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "fit_residual_norm_squared": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "minimum_pivot": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "fixed_second_component": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "b_effective": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "b2": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "uncertainty": {
          "type": "string"
        },
        "pivot_metric": {
          "type": "string"
        },
        "arithmetic_precision_bits": {
          "type": "integer",
          "minimum": 128,
          "maximum": 1004096
        },
        "arithmetic_enclosures": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?![\\s\\S])"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "required": [
            "source_center",
            "reference_center",
            "signed_unit_overlap"
          ]
        }
      }
    },
    "expected_rows": {
      "type": "integer",
      "minimum": 0
    }
  },
  "allOf": [
    {
      "allOf": [
        {
          "properties": {
            "data": {
              "required": [
                "pivot_metric"
              ]
            }
          }
        }
      ]
    },
    {
      "allOf": [
        {
          "properties": {
            "data": {
              "required": [
                "arithmetic_precision_bits",
                "arithmetic_enclosures"
              ]
            }
          }
        }
      ]
    },
    {
      "allOf": [
        {
          "properties": {
            "data": {
              "properties": {
                "uncertainty": {
                  "const": "finite_stored_inputs_with_arithmetic_enclosures; no_reference_approximation_or_construction_error_enclosure"
                }
              }
            }
          }
        }
      ]
    },
    {
      "if": {
        "properties": {
          "data": {
            "properties": {
              "outcome": {
                "enum": [
                  "point_measurement",
                  "rank_or_precision_unresolved"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "properties": {
              "arithmetic_enclosures": {
                "required": [
                  "difference_norm_squared"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "data": {
            "properties": {
              "outcome": {
                "const": "point_measurement"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "properties": {
              "arithmetic_enclosures": {
                "required": [
                  "fit_residual_norm_squared",
                  "minimum_pivot"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
