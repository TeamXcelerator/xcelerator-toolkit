{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ccm_reference_projection_analysis v1",
  "description": "Source-bound observations; shape validation does not establish numerical correctness, ground selection, or convergence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "semantics",
    "kind",
    "scope",
    "source_dependencies",
    "request",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "semantics": {
      "const": "ccm-retained-research-observations-v1"
    },
    "kind": {
      "const": "ccm_reference_projection_analysis"
    },
    "scope": {
      "const": "finite_point_inputs; no_source_error_enclosure; no_ground_selection_or_convergence_certificate"
    },
    "source_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "content_digest",
          "required_quality"
        ],
        "properties": {
          "key": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "logical_key",
              "parameters_digest"
            ],
            "properties": {
              "kind": {
                "type": "string"
              },
              "logical_key": {
                "type": "string"
              },
              "parameters_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "content_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "required_quality": {
            "enum": [
              "validated",
              "cross_checked",
              "certified",
              "published",
              "quarantined",
              "staged",
              "deprecated"
            ]
          }
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "options",
        "reference",
        "ordered_basis",
        "metric"
      ],
      "properties": {
        "options": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "working_precision_bits",
            "normalization",
            "fixed_second_component"
          ],
          "properties": {
            "working_precision_bits": {
              "type": "integer",
              "minimum": 0
            },
            "normalization": {
              "enum": [
                "unit_l2_dx",
                "center_one"
              ]
            },
            "fixed_second_component": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^-?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "reference": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "ordered_basis": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "metric": {
          "type": "string"
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "metric",
        "normalization",
        "source_center",
        "reference_center",
        "signed_unit_overlap",
        "difference_norm_squared",
        "gram",
        "rhs",
        "coefficients",
        "fit_residual_norm_squared",
        "minimum_pivot",
        "fixed_second_component",
        "b_effective",
        "b2",
        "uncertainty"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "normalization_unresolved",
            "rank_or_precision_unresolved",
            "point_measurement"
          ]
        },
        "metric": {
          "type": "string"
        },
        "normalization": {
          "enum": [
            "unit_l2_dx",
            "center_one"
          ]
        },
        "source_center": {
          "type": "string",
          "pattern": "^-?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
        },
        "reference_center": {
          "type": "string",
          "pattern": "^-?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
        },
        "signed_unit_overlap": {
          "type": "string",
          "pattern": "^-?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
        },
        "difference_norm_squared": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "gram": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^-?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
          }
        },
        "rhs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^-?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
          }
        },
        "coefficients": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^-?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "fit_residual_norm_squared": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "minimum_pivot": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "fixed_second_component": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "b_effective": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "b2": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "uncertainty": {
          "type": "string"
        }
      }
    }
  }
}
