{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ccm_stabilization_analysis v1",
  "description": "Source-bound observations; shape validation does not establish numerical correctness, ground selection, or convergence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "semantics",
    "kind",
    "scope",
    "source_dependencies",
    "request",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "semantics": {
      "const": "ccm-retained-research-observations-v1"
    },
    "kind": {
      "const": "ccm_stabilization_analysis"
    },
    "scope": {
      "const": "finite_point_inputs; no_source_error_enclosure; no_ground_selection_or_convergence_certificate"
    },
    "source_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "content_digest",
          "required_quality"
        ],
        "properties": {
          "key": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "logical_key",
              "parameters_digest"
            ],
            "properties": {
              "kind": {
                "type": "string"
              },
              "logical_key": {
                "type": "string"
              },
              "parameters_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "content_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "required_quality": {
            "enum": [
              "validated",
              "cross_checked",
              "certified",
              "published",
              "quarantined",
              "staged",
              "deprecated"
            ]
          }
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "options",
        "ordered_sources"
      ],
      "properties": {
        "options": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "working_precision_bits",
            "relative_tolerance",
            "consecutive_steps"
          ],
          "properties": {
            "working_precision_bits": {
              "type": "integer",
              "minimum": 0
            },
            "relative_tolerance": {
              "type": "string",
              "pattern": "^-?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
            },
            "consecutive_steps": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "ordered_sources": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lambda_squared",
        "observable",
        "qualification",
        "outcome",
        "rows"
      ],
      "properties": {
        "lambda_squared": {
          "type": "string",
          "pattern": "^-?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
        },
        "observable": {
          "const": "serialized_retained_Weil_eigenvalue"
        },
        "qualification": {
          "type": "string"
        },
        "outcome": {
          "enum": [
            "finite_rule_met",
            "finite_rule_not_met"
          ]
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "n_modes",
              "value",
              "relative_change",
              "status"
            ],
            "properties": {
              "source": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "n_modes": {
                "type": "integer",
                "minimum": 0
              },
              "value": {
                "type": "string",
                "pattern": "^-?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
              },
              "relative_change": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^-?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "status": {
                "enum": [
                  "initial",
                  "zero_denominator",
                  "within_rule",
                  "outside_rule"
                ]
              }
            }
          }
        }
      }
    }
  }
}
