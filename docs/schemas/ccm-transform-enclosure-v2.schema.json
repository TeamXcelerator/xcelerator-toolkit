{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ccm_transform_enclosure retained observation v2",
  "description": "Retained observation payload; exact requests and ancestry are authenticated by the manifest. Shape validation is not numerical proof. Separate same-kind finite/cohort/preparation APIs retain their own data validators.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "semantics",
    "kind",
    "scope",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "semantics": {
      "const": "ccm_transform_enclosure/value-v1"
    },
    "kind": {
      "const": "ccm_transform_enclosure"
    },
    "scope": {
      "const": "finite_retained_function_enclosures; source_scope_explicit; no_infinite_limit_claim"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnostic",
        "outcome",
        "reason",
        "lambda_squared",
        "n_modes",
        "source_precision_bits",
        "working_precision_bits",
        "convention",
        "assurance",
        "values",
        "rows"
      ],
      "properties": {
        "diagnostic": {
          "const": "transform_enclosure"
        },
        "outcome": {
          "enum": [
            "point_measurement",
            "certified_finite_enclosure",
            "partial_unresolved",
            "unresolved",
            "missing_input",
            "rank_or_precision_unresolved",
            "conditional_bound_expression",
            "sufficient_bound_unavailable"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "lambda_squared": {
          "type": "string",
          "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?![\\s\\S])"
        },
        "n_modes": {
          "type": "integer",
          "minimum": 0
        },
        "source_precision_bits": {
          "type": "integer",
          "minimum": 0
        },
        "working_precision_bits": {
          "type": "integer",
          "minimum": 0
        },
        "convention": {
          "type": "string"
        },
        "assurance": {
          "const": "finite_retained_function_enclosures; source_scope_explicit; no_infinite_limit_claim"
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?![\\s\\S])"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ordinal",
              "label",
              "outcome",
              "values",
              "notes"
            ],
            "properties": {
              "ordinal": {
                "type": "integer",
                "minimum": 1
              },
              "label": {
                "type": "string"
              },
              "outcome": {
                "enum": [
                  "point_measurement",
                  "certified_finite_enclosure",
                  "missing_input",
                  "budget_limited",
                  "carrier_or_unresolved",
                  "unresolved_denominator",
                  "cancellation_limited",
                  "unresolved_derivative",
                  "channels_resolved_budget_unassessed",
                  "conditional_budget_met",
                  "conditional_budget_not_met",
                  "conditional_budget_unresolved"
                ]
              },
              "values": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?![\\s\\S])"
                }
              },
              "notes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "label": {
                      "const": "contour_segment"
                    },
                    "outcome": {
                      "enum": [
                        "point_measurement",
                        "certified_finite_enclosure"
                      ]
                    }
                  }
                },
                "then": {
                  "properties": {
                    "values": {
                      "required": [
                        "start_re",
                        "start_im",
                        "end_re",
                        "end_im",
                        "argument_increment_lower",
                        "argument_increment_upper"
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "label": {
                      "const": "retained_root_enclosure"
                    },
                    "outcome": {
                      "enum": [
                        "point_measurement",
                        "certified_finite_enclosure"
                      ]
                    }
                  }
                },
                "then": {
                  "properties": {
                    "values": {
                      "required": [
                        "input_ordinal",
                        "value_real_lower",
                        "value_real_upper",
                        "derivative_real_lower",
                        "derivative_real_upper"
                      ]
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "enum": [
                  "point_measurement",
                  "certified_finite_enclosure",
                  "conditional_bound_expression"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "values": {
                "required": [
                  "contour_left",
                  "contour_right",
                  "contour_top",
                  "contour_bottom",
                  "origin_real_lower",
                  "origin_real_upper",
                  "unresolved_segments"
                ]
              }
            }
          }
        }
      ]
    },
    "expected_rows": {
      "type": "integer",
      "minimum": 0
    }
  },
  "allOf": [
    {
      "allOf": [
        {
          "properties": {
            "data": {
              "properties": {
                "rows": {
                  "items": {
                    "allOf": [
                      {
                        "if": {
                          "properties": {
                            "label": {
                              "const": "retained_root_enclosure"
                            },
                            "values": {
                              "required": [
                                "value_real_lower"
                              ]
                            }
                          }
                        },
                        "then": {
                          "properties": {
                            "values": {
                              "required": [
                                "t",
                                "t_lower",
                                "t_upper",
                                "input_point_precision_bits"
                              ]
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    }
  ]
}
