# Canonical text bytes in commits and checkouts, including Windows/WSL workflows.
* text=auto eol=lf

# Exact reference bytes participate in scientific provenance. Never convert them.
**/data/*.json -text
*.pdf binary

# Executable tooling must retain a kernel-readable LF shebang.
*.sh text eol=lf
tools/*.py text eol=lf

*.rs text eol=lf
*.c text eol=lf
*.h text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.lock text eol=lf
